generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  name              String
  email             String        @unique
  password          String
  totalPoints       Int           @default(0)
  createdAt         DateTime      @default(now())
  idUser            Int           @id @default(autoincrement())
  firstName         String?
  lastName          String?
  jobTitle          String?
  profilePicture    String?
  profilePictureUrl String?
  MicroCourse       MicroCourse[]
  MyLearning        MyLearning[]
  MyRewards         MyRewards[]
}

model MicroCourse {
  title         String
  description   String?
  createdAt     DateTime     @default(now())
  authorId      Int
  idMicroCourse Int          @id @default(autoincrement())
  category      String?
  videoUrl      String?
  pointsReward  Int          @default(0)
  User          User         @relation(fields: [authorId], references: [idUser], map: "MicroCourse_creatorId_fkey")
  MyLearning    MyLearning[]

  @@index([authorId], map: "MicroCourse_creatorId_idx")
  @@index([authorId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Reward {
  idReward          Int         @id @default(autoincrement())
  name              String
  description       String?
  pointsCost        Int         @default(0)
  availableQuantity Int?
  imageUrl          String?
  MyRewards         MyRewards[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MyLearning {
  idMyLearning Int         @id(map: "Learning_pkey") @default(autoincrement())
  userId       Int
  courseId     Int
  startDate    DateTime    @default(now())
  status       String      @default("in progress")
  MicroCourse  MicroCourse @relation(fields: [courseId], references: [idMicroCourse], map: "Learning_microCourseId_fkey")
  User         User        @relation(fields: [userId], references: [idUser], map: "Learning_userId_fkey")

  @@index([courseId], map: "MyLearning_microCourseId_idx")
  @@index([userId])
  @@index([courseId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model MyRewards {
  idHistory  Int      @id(map: "RewardHistory_pkey") @default(autoincrement())
  userId     Int
  rewardId   Int
  redeemedAt DateTime @default(now())
  Reward     Reward   @relation(fields: [rewardId], references: [idReward], map: "RewardHistory_rewardId_fkey")
  User       User     @relation(fields: [userId], references: [idUser], map: "RewardHistory_userId_fkey")

  @@index([rewardId])
  @@index([userId])
  @@index([rewardId], map: "RewardHistory_rewardId_idx")
  @@index([userId], map: "RewardHistory_userId_idx")
}
